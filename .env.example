# Copy this file to .env for local development.
# In production (Render, etc.) set these as real environment variables instead.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Non-guessable admin path — PRD requires the admin panel hidden from public nav.
ADMIN_URL_PATH=edc-manage-8f2a/

# Postgres connection string. Locally you can omit this to fall back to sqlite.
# Render provides this automatically when you attach a managed Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/edc_db

TIME_ZONE=Asia/Kolkata

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email (confirmation emails). Using Gmail SMTP as a fallback — swap for
# SendGrid/Mailgun's backend package if you go that route.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-edc-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-edc-gmail@gmail.com
EDC_CONTACT_EMAIL=edc@yourcollege.edu

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
